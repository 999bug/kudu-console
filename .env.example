# 部署配置示例：复制为 .env 后按实际环境修改（.env 不入库）
HOST_PORT=8088
KUDU_MASTERS=192.168.46.23:7051,192.168.46.23:7151,192.168.46.23:7251
JAVA_OPTS=-Xms256m -Xmx1g

# 仅 docker-compose.prod.yml 使用。生产建议钉死版本，回滚时改回上一个 tag
IMAGE=ghcr.io/999bug/kudu-console:latest

# 需要公网访问时填 Cloudflare Tunnel 的 token（见 DEPLOY.md）
TUNNEL_TOKEN=
